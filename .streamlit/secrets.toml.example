# .streamlit/secrets.toml.example
# Copy this file to .streamlit/secrets.toml and fill in your values.
# On Streamlit Cloud, paste these values in Settings > Secrets.

[smtp]
server = "smtp.gmail.com"
port = 587
username = "your-email@gmail.com"
password = "your-app-password"
from_email = "your-email@gmail.com"
to_email = "recipient@example.com"

[database]
# PostgreSQL connection string for persistent storage (optional).
# Without this, the app uses SQLite (data resets on restart).
#
# Supabase free tier: https://supabase.com → New Project → Settings → Database → Connection string → URI
# Format: postgresql://postgres.PROJECT:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
url = ""
